{
  "name": "glesys-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Glesys API. Manage your Glesys infrastructure from any MCP client.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "glesys-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "glesys-api": "^10.0.0",
    "got": "^15.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.8.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.0.0"
  }
}
