{
  "name": "@glesys/mcp",
  "version": "1.0.1",
  "description": "MCP server for the Glesys API. Manage your Glesys infrastructure from any MCP client.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "glesys",
    "cloud",
    "infrastructure"
  ],
  "homepage": "https://github.com/glesys/glesys-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glesys/glesys-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/glesys/glesys-mcp/issues"
  },
  "type": "module",
  "bin": {
    "glesys-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0 || >=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=12.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc -p tsconfig.test.json",
    "prepare": "npm run build",
    "prepack": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "inspect": "npx @modelcontextprotocol/inspector@2.12.0 node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.5"
  }
}
